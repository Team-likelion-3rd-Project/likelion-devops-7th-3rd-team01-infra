# Illustrative Seoul values only. Confirm permitted region/AZs with the team.
aws_region         = "ap-northeast-2"
availability_zones = ["ap-northeast-2a", "ap-northeast-2c"]
environment        = "practice"
# Current ON-PREM Traefik HTTP NodePort is 30080. AWS target/health port is not agreed.
